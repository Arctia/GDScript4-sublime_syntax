%YAML 1.2
---
name: GDScript (Godot Engine)
version: 2
file_extensions:
  - gd
scope: source.gdscript

variables:
  identifier: '\b[a-zA-Z_][a-zA-Z_0-9]*\b'
  node_path_segment: '%?{{identifier}}'
  catch_all: '(?=\S)'

contexts:
  prototype:
    - include: comments
    - include: line-continuation

  main:
    - include: folding-regions
    - include: docstrings
    - include: keywords
    - include: expressions
    - include: statements
    - include: meta-declarations
    - include: annotations
    - include: fallback-named-constants
    - include: fallback-object-names

  fallback-object-names:
    - match: '\b([A-Z][a-zA-Z0-9_]*)\b'
      scope: storage.type.gdscript

  fallback-named-constants:
    - match: '\b([A-Z0-9_]+)\b'
      scope: constant.other.gdscript

  folding-regions:
    - match: '^\s*(#region)\s+(.*)'
      scope: meta.region.gdscript
      captures:
        1: keyword.control.region.begin.gdscript
        2: entity.name.section.gdscript meta.fold.begin.gdscript
      push: region-content
    - match: '^\s*(#endregion)\b[^\S\n]*($\n?)'
      captures:
        1: keyword.control.region.end.gdscript
        2: meta.fold.end.gdscript

  region-content:
    - meta_scope: meta.region.gdscript
    - match: '^\s*(#endregion)\b[^\S\n]*($\n?)'
      captures:
        1: keyword.control.region.end.gdscript
        2: meta.fold.end.gdscript
      pop: true
    - include: main

  comments:
    - match: (#)(?!region|endregion).*
      scope: comment.line.number-sign.gdscript
      captures:
        1: punctuation.definition.comment.number-sign.gdscript

  docstrings:
    - match: ^\s*(""")
      captures:
        1: punctuation.definition.comment.begin.gdscript
      push:
        - meta_scope: comment.block.documentation.gdscript
        - meta_include_prototype: false
        - include: character-escapes
        - match: \"""
          scope: punctuation.definition.comment.end.gdscript
          pop: true

  annotations:
    - match: '@{{identifier}}'
      scope: storage.modifier.gdscript

  expressions:
    - include: literals
    - include: builtin-types
    - include: language-constants
    - include: dictionaries
    - include: control-flow
    - include: node-paths
    - include: operators
    - include: yield-expressions
    - include: function-calls
    - include: square-brackets

  statements:
    - match: "="
      scope: keyword.operator.assignment.gdscript
    - include: class-definition
    - include: enum-definition
    - include: signals
    - include: variable-declarations
    - include: function-definitions


  expect-type-name:
    - include: builtin-types
    - include: fallback-object-names
    - include: square-brackets # array types
    - match: '{{identifier}}' # fallback
      scope: storage.type.gdscript
    - include: else-pop

  keywords:
    - match: '\b(set|get)\b'
      scope: keyword.other.gdscript
    - match: '\b(static|remote|sync|master|slave)\b'
      scope: storage.modifier.gdscript

  node-paths:
    - meta_scope: meta.path.gdscript
    - match: '\$/?{{node_path_segment}}(?:/{{node_path_segment}})*'
      scope: entity.name.node.gdscript
    - match: '\%{{identifier}}(?:/{{node_path_segment}})*'
      scope: entity.name.node.gdscript

  literals:
    - include: strings
    - include: scope:source.python#numbers

  language-constants:
    - match: '\b(PI|TAU|INF|NAN)\b'
      scope: variable.language.gdscript
    - match: '\b(self|true|false|null)\b'
      scope: constant.language.gdscript

  builtin-types:
    - match: '\b(?:void|bool|int|float|String|funcref)\b'
      scope: storage.type.basic.gdscript
    - match: '\b(?:Vector[23]|Rect2|Matrix32?|Plane|Quat|AABB|Transform)\b'
      scope: support.class.vector.gdscript
    - match: '\b(?:Color|Image|NodePath|RID|Object|InputEvent)\b'
      scope: support.class.engine.gdscript
    - match: '\b(Array|Dictionary|ByteArray|IntArray|FloatArray|StringArray|Vector[23]Array|ColorArray)\b'
      scope: support.class.container.gdscript

  # TODO Most of these shouldn't be included in 'expression'!
  control-flow:
    - match: \b(?i:elif|else|for|if|while|break|continue|pass|return|match|await|breakpoint|when)\b
      scope: keyword.control.flow.gdscript

  operators:
    - match: '\b(?i:&&|and|in|is|!|not|\|\||or)\b'
      scope: keyword.operator.logical.gdscript
    - match: '<=|>=|==|<|>|!='
      scope: keyword.operator.comparison.gdscript
    - match: '\+=|-=|\*=|/=|%=|&=|\|=|\*|/|%|\+|-|<<|>>|&|\||\^|~'
      scope: keyword.operator.arithmetic.gdscript
    - match: '\b(as)\b'
      scope: keyword.operator.gdscript

  square-brackets:
    - match: '\['
      scope: punctuation.section.brackets.begin.gdscript
      push: square-brackets-body

  square-brackets-body:
    - meta_scope: meta.brackets.gdscript
    - match: '\]'
      scope: punctuation.section.brackets.end.gdscript
      pop: true
    - include: expressions
    - match: '\bvar\b' # To handle (more or less) binding patterns in match blocks
      scope: keyword.declaration.variable.gdscript
    - match: ','
      scope: punctuation.separator.sequence.gdscript

  yield-expressions:
    - match: \byield\b
      scope: keyword.control.flow.yield.gdscript
      set:
        - match: (?=\()
          set: function-call-arguments
        - include: immediately-pop

  ### [ Strings ] #########################################################################

  strings:
    - include: double-quoted-strings
    - include: single-quoted-strings
    - include: node-path-strings
    - include: string-name-strings

  # TODO: Raw strings
  double-quoted-strings:
    - match: \"""
      scope: punctuation.definition.string.begin.gdscript
      push:
        - meta_scope: meta.string.gdscript string.quoted.double.block.gdscript
        - meta_include_prototype: false
        - include: character-escapes
        - match: \"""
          scope: punctuation.definition.string.end.gdscript
          pop: true
    - match: \"
      scope: punctuation.definition.string.begin.gdscript
      push:
        - meta_scope: meta.string.gdscript string.quoted.double.gdscript
        - meta_include_prototype: false
        - include: character-escapes
        - match: \"
          scope: punctuation.definition.string.end.gdscript
          pop: true

  single-quoted-strings:
    - match: \'
      scope: punctuation.definition.string.begin.gdscript
      push:
        - meta_scope: meta.string.gdscript string.quoted.single.gdscript
        - meta_include_prototype: false
        - include: character-escapes
        - match: \'
          scope: punctuation.definition.string.end.gdscript
          pop: true

  node-path-strings:
    - match: '\^"'
      push:
        - meta_scope: string.quoted.double.node-path.gdscript
        - match: '(?<!\\)"'
          pop: true
    - match: '\$"'
      push:
        - meta_scope: entity.name.node.gdscript
        - match: '(?<!\\)"'
          pop: true
    - match: '\%"'
      push:
        - meta_scope: entity.name.node.gdscript
        - match: '(?<!\\)"'
          pop: true

  string-name-strings:
    - match: '\&"'
      push:
        - meta_scope: string.quoted.double.string-name.gdscript
        - match: (?<!\\)"
          pop: true

  character-escapes:
    - match: \\["'\\]
      scope: constant.character.escape.gdscript

  ### [ Dictionary literals ] #########################################################################

  dictionaries:
    - match: '{'
      scope: punctuation.section.mapping.begin.gdscript
      push: dictionary-keys

  dictionary-keys:
    - meta_scope: meta.mapping.gdscript
    - include: dictionary-close-pop
    - match: '[:=]'
      scope: punctuation.separator.mapping.key-value.gdscript
      set: dictionary-values
    - match: ','
      scope: punctuation.separator.mapping.key-value.gdscript
    - match: '{{identifier}}(?=\s*[,}\n])'
      scope: entity.name.enum.gdscript
    - include: expressions

  dictionary-values:
    - meta_scope: meta.mapping.gdscript
    - include: dictionary-close-pop
    - match: ','
      scope: punctuation.separator.mapping.gdscript
      set: dictionary-keys
    - match: '\bvar\b' # To handle (more or less) binding patterns in match blocks
      scope: keyword.declaration.variable.gdscript
    - include: expressions

  dictionary-close-pop:
    - match: '\s*(})'
      captures:
        1: punctuation.section.mapping.end.gdscript
      pop: true

  ### [ Function calls ] #########################################################################

  function-calls:
    - match: '\bassert\b'
      scope: keyword.control.flow.gdscript
      push: function-call-arguments
    - match: '{{identifier}}(?=\s*\()'
      scope: meta.function-call.gdscript variable.function.gdscript
      push: function-call-arguments

  function-call-arguments:
    - meta_scope: meta.function-call.arguments.gdscript
    - match: \(
      scope: punctuation.section.arguments.begin.gdscript
    - include: expressions
    - match: ','
      scope: punctuation.separator.arguments.gdscript
    - match: \)
      scope: punctuation.section.arguments.end.gdscript
      pop: true

  ### [ Script-level meta-declarations ] #########################################################################

  meta-declarations:
    - match: '\b(class_name)\b'
      scope: keyword.declaration.module.gdscript
      push: meta-class-name-identifier
    - match: '\b(extends)\b'
      scope: keyword.declaration.module.gdscript
      push: expect-meta-extends-identifier

  meta-class-name-identifier:
    - match: '{{identifier}}'
      scope: entity.name.class.gdscript
      pop: true

  expect-meta-extends-identifier:
    - match: '{{identifier}}'
      scope: entity.other.inherited-class.gdscript
      pop: true
    - match: '{{catch_all}}'
      set:
        # TODO this is technically too permissive, ideally this would be an 'expect-string'
        - include: strings
        - include: else-pop
    - include: else-unexpected

  ### [ Definition parts ] #########################################################################

  accept-type-annotation:
    - match: ':'
      scope: punctuation.separator.type.gdscript
      set: expect-type-name
    - include: else-pop

  accept-initializer:
    - match: '='
      scope: keyword.operator.assignment.gdscript
      set:
        - include: expressions
        - include: else-pop
    - include: else-pop


  ### [ Function definitions ] #########################################################################

  function-definitions:
    - meta_scope: meta.function.gdscript
    - match: '(@abstract)\s+(func)\b'
      captures:
        1: storage.modifier.gdscript
        2: keyword.declaration.function.gdscript
      push: 
        - expect-function-parameter-list
        - expect-function-name

    - match: '\b(func)\b'
      scope: keyword.declaration.function.gdscript
      push:
        - expect-func-body
        - expect-function-parameter-list
        - expect-function-name

  expect-function-name:
    - match: '{{identifier}}'
      scope: entity.name.function.gdscript
      pop: true

    - include: else-unexpected

  expect-function-parameter-list:
    - match: '\('
      scope: punctuation.section.parameters.begin.gdscript
      set: accept-function-parameter
    - include: else-unexpected

  accept-function-parameter:
    - meta_scope: meta.function.parameters.gdscript
    - match: '{{identifier}}'
      scope: variable.parameter.gdscript
      set:
        - accept-function-parameter-next-or-end
        - accept-initializer # default values
        - accept-type-annotation
    - include: expect-function-parameter-list-end

  accept-function-parameter-next-or-end:
    - meta_scope: meta.function.parameters.gdscript
    - match: ','
      scope: punctuation.separator.parameters.gdscript wheeeee
      set: accept-function-parameter
    - include: expect-function-parameter-list-end

  expect-function-parameter-list-end:
    - match: '\)'
      set: accept-function-return-type
    - include: else-unexpected

  accept-function-return-type:
    - match: '->'
      scope: keyword.operator.arrow.forward.gdscript
      set: expect-type-name
    - include: else-pop

  expect-func-body:
    - match: ':'
      scope: punctuation.section.function.begin.gdscript
      pop: true
    - include: else-unexpected

  ### [ Class definitions ] #########################################################################

  class-definition:
  - match: '\bclass\b'
    scope: keyword.declaration.class.gdscript
    push: [expect-class-body, accept-extends-clause, expect-class-name]

  expect-class-name:
    - match: '{{identifier}}'
      scope: entity.name.class.gdscript
      pop: true
    - include: else-unexpected

  accept-extends-clause:
    - match: '\bextends\b'
      scope: keyword.other.extends.gdscript
      set: expect-type-name
    - include: else-pop

  expect-class-body:
    - match: ':'
      scope: punctuation.section.definition.begin.gdscript
      pop: true
    - include: else-unexpected

  ### [ Enum definition ] #########################################################################

  enum-definition:
  - match: '\benum\b'
    scope: keyword.declaration.enum.gdscript
    push: [expect-enum-body, accept-enum-name]

  accept-enum-name:
    - match: '{{identifier}}'
      scope: entity.name.enum.gdscript
      pop: true
    - include: else-pop

  expect-enum-body:
    - match: '{'
      scope: punctuation.section.brackets.begin.gdscript
      set: accept-enum-member
    - include: else-unexpected

  accept-enum-member:
    - match: '}'
      scope: punctuation.section.brackets.end.gdscript
      pop: true
    - match: '{{identifier}}'
      scope: entity.name.constant.gdscript
      set: [expect-comma-or-enum-end, accept-initializer]
    - include: else-unexpected

  expect-comma-or-enum-end:
    - match: '}'
      scope: punctuation.section.brackets.end.gdscript
      pop: true
    - match: ','
      scope: punctuation.separator.gdscript
      set: accept-enum-member
    - include: else-unexpected

  ### [ Signal definitions ] #########################################################################

  signals:
    - match: ^\s*signal\b
      scope: storage.type.signal.gdscript
      push: signal-definition

  signal-definition:
    - meta_scope: meta.signal.gdscript
    - match: '{{identifier}}'
      scope: entity.name.signal.gdscript
    - match: (?=\()
      set: signal-parameters
    - include: line-continuation-or-pop

  signal-parameters:
    - meta_scope: meta.signal.parameters.gdscript
    - match: \(
      scope: punctuation.section.parameters.begin.gdscript
    - match: '{{identifier}}'
      scope: variable.parameter.gdscript
    - match: ','
      scope: punctuation.separator.parameters.gdscript
    - match: \)
      scope: punctuation.section.parameters.end.gdscript
      pop: true

  ### [ Variable declarations ] #########################################################################

  variable-declarations:
    - match: '\bvar\b'
      scope: keyword.declaration.variable.gdscript
      push:
        - accept-property-block
        - accept-initializer
        - accept-type-annotation
        - expect-variable-name
    - match: '\bconst\b'
      scope: keyword.declaration.variable.constant.gdscript
      push:
        - accept-initializer
        - accept-type-annotation
        - expect-constant-name

  expect-variable-name:
    - match: '{{identifier}}'
      scope: variable.other.gdscript
      pop: true
    - include: else-unexpected

  expect-constant-name:
    - match: '{{identifier}}'
      scope: entity.name.constant.gdscript
      pop: true
    - include: else-unexpected

  accept-property-block:
    - match: ':'
      scope: punctuation.separator.block.begin.gdscript
      pop: true
      # TODO could go through and parse set(value) and co, but I'm lazy
    - include: else-pop

  ### [ General Purpose ] #########################################################################

  # Taken from default sublime python syntax
  line-continuation-or-pop:
    - include: line-continuation
    - match: (?=\s*[\n#])
      pop: true

  line-continuation:
    - match: (\\)(.*)$\n?
      captures:
        1: punctuation.separator.continuation.line.gdscript
        2: invalid.illegal.unexpected-text.gdscript

  else-pop:
    - match: '{{catch_all}}'
      pop: true

  else-unexpected:
    - match: '[^\s]'
      scope: invalid.illegal.unexpect.gdscript
      pop: true

  immediately-pop:
    - match: ''
      pop: true
